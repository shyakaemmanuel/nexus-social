# GEMINI_API_KEY: Required for Gemini AI API calls.
# This value may be injected at runtime from your environment or secret manager.
# Configure it in your deployment or local .env file.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# This value may be injected at runtime with the service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
